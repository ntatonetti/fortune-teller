# Copy to .env and fill in. The Claude and ElevenLabs keys and the voice ID are
# required: the booth runs online only, and the server won't start without them.

ORACLE_NAME=Madame Mechanika

# --- Claude (https://console.anthropic.com -> API keys) ---
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5     # try claude-haiku-5-5 if readings feel slow
# GREET_EFFORT=low
# FORTUNE_EFFORT=low
# GREET_TIMEOUT_S=8        # give up on the greeting after this
# FORTUNE_TIMEOUT_S=20
# ASKED_MODEL=claude-haiku-5-5   # judges whether a guest has finished asking
# ASKED_TIMEOUT_S=4
# CHAT_MODEL=claude-haiku-5-5    # writes the questions she asks them back, mid-reading

# --- The conversation ---
# For testing: auto, or every adult reading tarot, or every one conversation
# STYLE=auto
# After their question, she asks them one back (true/false)
# FOLLOW_UP=true
# They draw tarot cards in her ball; she asks about the first, then reads them one by one
# TAROT=true
# The most cards they draw (1-5); they can say "enough" sooner
# CARDS=3

# --- ElevenLabs voice (https://elevenlabs.io -> Developers -> API keys) ---
ELEVENLABS_API_KEY=
# Voice ID from the Voice Library (open a voice -> "..." -> Copy voice ID)
ELEVENLABS_VOICE_ID=
# Voices to choose between on the setup screen: Name=voice id, comma between
# (add and remove them there too; her own voice is always listed)
# VOICES="Crone=gDQfVolj9RbmXgumLcOq, Witch=S0erf8BY5pzZPCxzCfku"
# ELEVENLABS_MODEL=eleven_flash_v2_5   # or eleven_flash_v2, eleven_turbo_v2_5, eleven_turbo_v2, eleven_multilingual_v2, eleven_v3, eleven_v4_turbo, eleven_v4

# --- Printer: none | console | usb ---
PRINTER=console
# For usb, find the IDs with: system_profiler SPUSBDataType  (Vendor ID / Product ID)
# 0x0416/0x5011 is the "POS80 Printer USB" board in the NetumScan NS8360 (80 mm) and many clones
# PRINTER_USB_VENDOR=0x0416
# PRINTER_USB_PRODUCT=0x5011
# PRINTER_WIDTH_CHARS=48   # 32 for 58mm paper, 48 for 80mm
# Bulk endpoints, only if your printer differs (ioreg -p IOUSB -l, or pyusb, lists them)
# PRINTER_USB_OUT_EP=0x01
# PRINTER_USB_IN_EP=0x81

# Where the guest's face flickers up: ball (in her crystal ball) or face (over her face)
# FLICKER_WHERE=ball
# How many times the guest's face flickers up while she consults (0 = never)
FACE_FLICKERS=3
# How solid the guest's face is: 1 = solid, 0.5 = half mist
FLICKER_OPACITY=1
# Kids see their own face too (true/false)
KID_FLICKER=false

# --- Timings: every pause, wait and transition, in seconds (defaults shown) ---
# All of these (and the flicker, memory and voice settings) can also be edited on the setup screen.
# Sleep and waking
# WAKE_HOLD_S=0.7          # a face must stay at the booth this long before she wakes
# WAKE_PAUSE_S=1.9         # after waking she looks at them at least this long before the greeting
# DIM_S=0.9                # her light fading down asleep or coming up awake
# FALL_ASLEEP_S=1.6        # after a reading, until she's asleep and can be woken again
# REWAKE_GONE_S=2.5        # the last guest out of sight this long is gone: then even they can wake her again
# REWAKE_ANYWAY_S=30       # the last guest still lingering this long after their reading is greeted again
# SAME_GUEST=0.6           # how alike (0-1) a face's costume colours must be to the last guest's to count as them, not someone new
# PEEK_AFTER_S=2.5         # someone lingering out of range: her eyes follow them after this
# BECKON_AFTER_S=7         # still lingering: she calls them over after this
# BECKON_EVERY_S=60        # at most one call-over per this
# BLINK_MIN_S=2.5          # awake, she blinks every 2.5 to 7.5 seconds
# BLINK_MAX_S=7.5
# BLINK_S=0.17             # eyes shut per blink
# SLEEP_TALK=0.2           # share of her sleep, with no one about, spent talking in it (0 = never)
# SLEEP_MUMBLE=0.5         # share of that sleep talk muffled to an unintelligible murmur
# WAKE_STARTLE=0.35        # share of wakings where she snorts awake, dazed (0 = never)
# WAKE_DAZED_S=1.6         # how long she looks around, dazed, after a startled waking
# her looks
# LOOK_SIDE=0.35           # how far off-centre her gaze must be (0-1) before her eyes turn to look that way
# MOUTH_OPEN=3            # her widest mouth: 1 parted, 2 half dropped, 3 dropped to her teeth
# GLANCE_MIN_S=5           # awake, shortest gap between her glances away (left, right, up or down)
# GLANCE_MAX_S=14          # longest gap between glances away
# GLANCE_S=0.9             # how long a glance away holds (0 = she never glances away)
# Paying
# PAY_TIMEOUT_S=40         # no secret (or kid's spooky sound) by then: she goes back to sleep
# SECRET_LISTEN_S=12       # each stretch of listening for a whispered secret or spooky sound
# COIN_PAUSE_S=0.8         # after the button pays, before she asks their question
# Their question
# QUESTION_MAX_S=30        # longest she listens to a question
# QUESTION_START_S=10      # gives up if an adult hasn't started talking by then
# QUESTION_START_KID_S=12  # same for kids
# QUESTION_PAUSE_S=2.2     # a pause this long ends an adult's question
# QUESTION_PAUSE_KID_S=3   # same for kids
# QUESTION_TRAILING_S=2.5  # added to the pause if they trailed off ("will I...")
# QUESTION_MORE_S=6        # added if Claude says the question isn't finished
# HEARD_SHOW_S=0.6         # their question stays on screen this long before she answers
# Drawing the cards
# DRAW_WAIT_S=12           # no press or word by then: the card showing picks itself
# CARD_SHUFFLE_S=0.42      # each card shows this long as they shuffle through her ball
# CARD_HOLD_S=0.8          # a chosen card stays in the ball this long after she names its place
# Consulting, the fortune, the ticket
# CONSULT_MIN_S=3.5        # shortest consult, even if the fortune comes back sooner
# GLIMPSE_MIN_S=0.33       # each glimpse of the guest's face lasts 0.33 to 0.58 s
# GLIMPSE_MAX_S=0.58
# GLIMPSE_GAP_MIN_S=0.42   # gap between glimpses: 0.42 to 0.83 s
# GLIMPSE_GAP_MAX_S=0.83
# GLITCH_S=1.3             # her mid-fortune seizure (voice stops, head shakes, their face stutters)
# GLITCH_AT_MIN=0.3        # the seizure comes 30% to 55% of the way through the fortune
# GLITCH_AT_MAX=0.55
# SHUTDOWN_GLITCH_S=0.5    # the shudder when a guest walks away mid-reading
# TICKET_PAUSE_S=1.3       # the ticket printing, before her farewell
# SUBTITLE_LINGER_S=0.7    # subtitles stay up this long after she stops talking
# NO_VOICE_WORD_S=0.4      # per word, if a voice clip fails and only subtitles show
# The walk-away limit (8 s) is set at the booth with J / K, not here.
